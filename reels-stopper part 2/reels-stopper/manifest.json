{
  "manifest_version": 3,
  "name": "Reels Stopper — Break the Scroll",
  "version": "1.0",
  "description": "Limits mindless scrolling on Instagram Reels & YouTube Shorts with smart cooldowns, reflection prompts, and a stats dashboard.",
  "permissions": ["storage", "alarms"],
  "host_permissions": [
    "*://*.instagram.com/*",
    "*://*.youtube.com/*"
  ],
  "background": {
    "service_worker": "background.js"
  },
  "content_scripts": [
    {
      "matches": ["*://*.instagram.com/*", "*://*.youtube.com/*"],
      "js": ["storage.js", "quotes.js", "content.js"],
      "css": ["overlay.css"],
      "run_at": "document_idle"
    }
  ],
  "action": {
    "default_popup": "popup.html",
    "default_icon": {
      "16": "icons/icon16.png",
      "48": "icons/icon48.png",
      "128": "icons/icon128.png"
    }
  },
  "icons": {
    "16": "icons/icon16.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  }
}
